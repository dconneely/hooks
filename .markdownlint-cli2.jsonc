{
  // markdownlint's default rules, with two changes.
  //
  // MD013: a 100-column line length, which must match Prettier's printWidth
  // in .prettierrc.json. Code blocks, tables and headings are exempt, since
  // none can be wrapped. `stern` also flags a prose line whose last word runs
  // past the limit, which the default lets through; a line that is one long
  // word, such as a bare URL, still passes.
  //
  // MD024: the same heading is allowed under different parent headings.
  //
  // No "globs": with one set, markdownlint-cli2 lints those files as well as
  // the ones the hook passes, including untracked ones.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "stern": true
    },
    "MD024": {
      "siblings_only": true
    }
  }
}
